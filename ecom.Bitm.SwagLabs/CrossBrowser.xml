<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Suite">

	<!-- Chrome -->
	<test name="Chrome Test">
		<parameter name="browser" value="chrome" />

		<classes>
      <class name="ecom.Bitm.SwagLabs.login.Loginpage_Test"/>
      <class name="ecom.Bitm.SwagLabs.product.ProductPage_Test"/>
      <class name="ecom.Bitm.SwagLabs.checkout.CheckoutPage_Test"/>
      <class name="ecom.Bitm.SwagLabs.addToCart.CartPage_Test"/>
	  <class name="ecom.Bitm.SwagLabs.hamburger.HamburgerMenu_Test"/>
		</classes>
	</test>

	<!-- Firefox -->
	<test name="Firefox Test">
		<parameter name="browser" value="firefox" />

		<classes>
      <class name="ecom.Bitm.SwagLabs.login.Loginpage_Test"/>
      <class name="ecom.Bitm.SwagLabs.product.ProductPage_Test"/>
      <class name="ecom.Bitm.SwagLabs.checkout.CheckoutPage_Test"/>
      <class name="ecom.Bitm.SwagLabs.addToCart.CartPage_Test"/>
	  <class name="ecom.Bitm.SwagLabs.hamburger.HamburgerMenu_Test"/>	
		</classes>
	</test>

	<!-- Edge -->
	<test name="Edge Test">
		<parameter name="browser" value="edge" />

		<classes>
      <class name="ecom.Bitm.SwagLabs.login.Loginpage_Test"/>
      <class name="ecom.Bitm.SwagLabs.product.ProductPage_Test"/>
      <class name="ecom.Bitm.SwagLabs.checkout.CheckoutPage_Test"/>
      <class name="ecom.Bitm.SwagLabs.addToCart.CartPage_Test"/>
	  <class name="ecom.Bitm.SwagLabs.hamburger.HamburgerMenu_Test"/>
		</classes>
	</test>

</suite	>
