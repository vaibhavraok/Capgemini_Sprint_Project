            <class name="com.Bitm.NinzaHRM.home.HomePage_Test"/>
            <class name="com.Bitm.NinzaHRM.projects.ProjectsPage_Test"/>
            <class name="com.Bitm.NinzaHRM.settings.SettingsPage_Test"/>
		</classes>
	</test>

	<!-- Edge -->
	<test name="Edge Test">
		<parameter name="browser" value="edge" />

		<classes>
      		<class name="com.Bitm.NinzaHRM.login.LoginPage_Test"/>
            <class name="com.Bitm.NinzaHRM.home.HomePage_Test"/>
            <class name="com.Bitm.NinzaHRM.projects.ProjectsPage_Test"/>
            <class name="com.Bitm.NinzaHRM.settings.SettingsPage_Test"/>
		</classes>
